# Copy to .env (git-ignored) and fill from the Supabase dashboard.
# NEVER commit real values. NEVER ship the service-role key in a game build.

# Postgres connection for the API. MUST be the Supabase POOLER url
# (pgbouncer, transaction mode) — a direct connection per serverless
# invocation exhausts the database under load.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:6543/postgres

# JWT verification — identity crosses from the game by verified token (ADR 0010).
# Prefer JWKS (asymmetric). SUPABASE_JWT_SECRET is the legacy HS256 fallback.
SUPABASE_JWKS_URL=https://<game-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=
JWT_ISSUER=https://<game-project-ref>.supabase.co/auth/v1
